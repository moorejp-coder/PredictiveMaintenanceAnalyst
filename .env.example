APP_NAME=PRISM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Optional. Leave the key empty and PRISM shows its built-in explanation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT=8
PRISM_INVESTIGATOR=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password for the /overrides page. Leave empty and the page returns 404.
OVERRIDE_LOG_PASSWORD=

# Sign-in gate. false (default): the dashboard is public. true: sign-in
# required, plus the judge invite page and set-password page. Turn on only
# after HTTPS works.
REQUIRE_LOGIN=false

# Password for /admin/invites, where the entrant invites judges by email.
# Use a value no other PRISM password uses. Empty: the page returns 404.
# Invites need working MAIL_* settings above (MAIL_MAILER=log writes the
# email to the log instead of sending it).
INVITE_ADMIN_PASSWORD=

# Optional backup: one fixed judge account. Leave empty and none is made. Set a
# password you use nowhere else, then run: php artisan db:seed --class=JudgeSeeder
JUDGE_NAME="Contest Judge"
JUDGE_EMAIL=
JUDGE_PASSWORD=

# Optional. Only needed if you switch away from the defaults above (sqlite,
# log mailer, file cache). Names only, no values. Real values go in .env or
# the Elastic Beanstalk console, never in code.
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=
# REDIS_USERNAME=
# REDIS_URL=
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# LOG_SLACK_WEBHOOK_URL=
# SLACK_BOT_USER_OAUTH_TOKEN=
