APP_NAME=PRISM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Security audit log (see SECURITY.md). One JSON line per security event,
# kept apart from the application log. Where the lines go: audit_stderr
# (default), audit_file (storage/logs/audit/audit.log, or AUDIT_LOG_PATH),
# both separated by a comma, or null to switch it off.
# AUDIT_LOG_STACK=audit_stderr
# AUDIT_LOG_PATH=
# An alert goes into the audit log when /api/ routes answer with this many
# errors (any 4xx or 5xx) inside the window: per IP address, or all together.
# AUDIT_API_ERROR_WINDOW=60
# AUDIT_API_ERRORS_PER_IP=20
# AUDIT_API_ERRORS_TOTAL=100

# Security alerts (see docs/ALERTS.md). An alert is a line in the audit log.
# PRISM sends no email or Slack message for it.
# Header a CDN in front of PRISM sets to the visitor's country, for the
# new-country alert. Leave empty if there is no such CDN (a visitor can send
# any header). Examples: CloudFront-Viewer-Country, CF-IPCountry.
# ALERT_COUNTRY_HEADER=
# ALERT_NEW_NETWORK=true
# Limits, with their defaults. See config/prism.php.
# ALERT_FAILED_LOGINS=10
# ALERT_FAILED_LOGINS_WINDOW=300
# ALERT_ACCOUNTS_PER_IP=50
# ALERT_ACCOUNTS_PER_IP_WINDOW=3600
# ALERT_BULK_RECORDS=100
# ALERT_BULK_REQUESTS=10
# ALERT_BULK_WINDOW=60
# ALERT_PASSWORD_LINKS=3
# ALERT_PASSWORD_LINKS_WINDOW=3600
# ALERT_AUTH_FLOOR=30
# ALERT_AUTH_MULTIPLIER=3
# ALERT_AUTH_PER_IP_CAP=20
# ALERT_AUTH_BASELINE_HOURS=24
# ALERT_COOLDOWN=3600

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Optional. Leave the key empty and PRISM shows its built-in explanation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT=8
PRISM_INVESTIGATOR=true
# Optional spending limits. Defaults are in config/prism.php.
# PRISM_AI_DAILY_CAP=1000
# PRISM_AI_DAILY_BUDGET_USD=1.00
# PRISM_AI_USER_HOURLY_BUDGET_USD=0.05
# PRISM_AI_INPUT_USD_PER_MTOK=0.10
# PRISM_AI_OUTPUT_USD_PER_MTOK=0.50
# PRISM_EMAIL_DAILY_CAP=100
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sign-in gate. false (default): the dashboard is public. true: sign-in
# required, plus the judge invite page and set-password page. Turn on only
# after HTTPS works.
REQUIRE_LOGIN=false

# Admin account. Only an admin opens /overrides and /admin/invites (where the
# entrant invites judges by email). Set both values, 12+ character password
# that no other PRISM password uses, then run:
#   php artisan db:seed --class=AdminSeeder
# Empty: no admin exists and both pages return 403. ADMIN_EMAILS is an
# optional comma-separated list of extra admin addresses (verified emails only).
# Invites need working MAIL_* settings above (MAIL_MAILER=log writes the
# email to the log instead of sending it).
ADMIN_NAME="PRISM Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMAILS=

# Optional backup: one fixed judge account. Leave empty and none is made. Set a
# password you use nowhere else, then run: php artisan db:seed --class=JudgeSeeder
JUDGE_NAME="Contest Judge"
JUDGE_EMAIL=
JUDGE_PASSWORD=

# Optional. Only needed if you switch away from the defaults above (sqlite,
# log mailer, file cache). Names only, no values. Real values go in .env or
# the Elastic Beanstalk console, never in code.
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_URL=
# REDIS_USERNAME=
# REDIS_URL=
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# LOG_SLACK_WEBHOOK_URL=
# SLACK_BOT_USER_OAUTH_TOKEN=
