option_settings:
  # Write each audit line to standard error (kept) and to a file outside the
  # app folder. A deploy replaces the app folder, so a file inside it would
  # vanish. .platform/hooks/postdeploy/03_audit_log.sh creates the folder and
  # asks the CloudWatch agent to ship the file to CloudWatch Logs.
  aws:elasticbeanstalk:application:environment:
    AUDIT_LOG_STACK: audit_stderr,audit_file
    AUDIT_LOG_PATH: /var/log/prism/audit.log
