option_settings:
  # Point the web server at Laravel's public folder.
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    # Install production packages only when Elastic Beanstalk runs composer.
    composer_options: --no-dev --optimize-autoloader
  # Non-secret settings for a single instance. The only stored data is the
  # override log, in a SQLite file outside the app folder (see
  # .platform/hooks/postdeploy). OVERRIDE_LOG_PASSWORD is a secret: add it in
  # the Elastic Beanstalk console, like APP_KEY.
  # APP_KEY and APP_URL are NOT set here. Add them as environment properties
  # in the Elastic Beanstalk console so no secret lives in the code.
  aws:elasticbeanstalk:application:environment:
    APP_NAME: PRISM
    APP_ENV: production
    APP_DEBUG: "false"
    LOG_CHANNEL: stderr
    SESSION_DRIVER: file
    CACHE_STORE: file
    QUEUE_CONNECTION: sync
    DB_CONNECTION: sqlite
    DB_DATABASE: /var/app/prism-data/prism.sqlite
