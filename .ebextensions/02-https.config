# Opens port 443 on the single instance so browsers can reach HTTPS.
# Source: AWS docs, "Terminating HTTPS on EC2 instances" for single instances.
Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt" : ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      ToPort: 443
      FromPort: 443
      CidrIp: 0.0.0.0/0
